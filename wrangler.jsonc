{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gta6walkthroughapp",
  "compatibility_date": "2026-08-26",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "exclude": [
      "node_modules/**",
      ".git/**",
      ".wrangler/**",
      "api/**",
      "scripts/**"
    ]
  }
}