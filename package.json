{
  "name": "gta6-walkthrough",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "python3 -m http.server 5173",
    "api": "node api/server.mjs",
    "seed": "node scripts/seed.mjs",
    "check": "node --check api/server.mjs && node --check scripts/seed.mjs && node --check js/app.js && node --check js/content.js && node --check js/data.js && node --check js/firebase-config.js && node --check js/firebase.js && node --check js/seed.js",
    "deploy": "firebase deploy --only firestore:rules,firestore:indexes,hosting",
    "emulate": "firebase emulators:start"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "psn-api": "^2.6.0"
  },
  "devDependencies": {
    "firebase-admin": "^13.0.1",
    "firebase-tools": "^13.29.1"
  }
}
