rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Email-authenticated (non-anonymous) user
    function isEmailUser() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Admin: role == 'Admin' in users collection OR admin: true token custom claim
    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin')
      );
    }

    // Pending Walkthroughs: email-authenticated users can submit here;
    // Admins can read, update, delete; authors can delete or view their own submission.
    match /pendingWalkthroughs/{pendingId} {
      allow read: if isAdmin() || (signedIn() && resource.data.authorUid == request.auth.uid);

      allow create: if isEmailUser()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.get('summary', '').size() <= 400
        && request.resource.data.get('steps', []) is list
        && request.resource.data.get('likes', 0) == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isAdmin();

      allow delete: if isAdmin() || (signedIn() && resource.data.authorUid == request.auth.uid);
    }

    // Public Walkthroughs: public read; admins can create (publish from pending), edit, delete;
    // signed-in users can like.
    match /walkthroughs/{walkthroughId} {
      allow read: if true;

      allow create: if isAdmin();

      allow update: if isAdmin()
        || (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
          && request.resource.data.likes == resource.data.get('likes', 0) + 1);

      allow delete: if isAdmin();
    }

    // Users: public reads, owner CRUD, admin can delete any user.
    match /users/{userId} {
      allow read: if true;

      allow create: if isAdmin() || (isOwner(userId)
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 24
        && request.resource.data.username.matches('^[a-zA-Z0-9_]+$')
        && request.resource.data.usernameLower == request.resource.data.username.lower()
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 60
        && request.resource.data.get('bio', '').size() <= 400
        && request.resource.data.get('location', '').size() <= 80
        && request.resource.data.role == 'Member');

      allow update: if isAdmin() || (isOwner(userId)
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['username', 'usernameLower', 'displayName', 'bio', 'location'])
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 24
        && request.resource.data.username.matches('^[a-zA-Z0-9_]+$')
        && request.resource.data.usernameLower == request.resource.data.username.lower()
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 60
        && request.resource.data.get('bio', '').size() <= 400
        && request.resource.data.get('location', '').size() <= 80);

      // Owner or admin can delete a user document.
      allow delete: if isOwner(userId) || isAdmin();

      match /manualAchievements/{achievementId} {
        allow read: if isAdmin() || isOwner(userId);

        allow create: if isAdmin() || (isOwner(userId)
          && request.resource.data.platform == 'manual'
          && request.resource.data.gameTitle is string
          && request.resource.data.gameTitle.size() > 0
          && request.resource.data.gameTitle.size() <= 120
          && request.resource.data.achievementName is string
          && request.resource.data.achievementName.size() > 0
          && request.resource.data.achievementName.size() <= 120
          && request.resource.data.get('description', '').size() <= 500
          && request.resource.data.unlocked == false
          && request.resource.data.completedAt == null
          && request.resource.data.createdAt == request.time);

        allow update: if isAdmin() || (isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unlocked', 'completedAt'])
          && (request.resource.data.unlocked
            ? request.resource.data.completedAt == request.time
            : request.resource.data.completedAt == null));

        allow delete: if isAdmin() || isOwner(userId);
      }
    }

    match /threads/{threadId} {
      allow read: if true;

      allow create: if signedIn()
        && (isOwner(request.resource.data.authorUid) || isAdmin())
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 4000
        && request.resource.data.category in ['General', 'Guides', 'Tech', 'News', 'GTA Online', 'Off-topic']
        && request.resource.data.replyCount == 0
        && request.resource.data.get('likes', 0) == 0
        && request.resource.data.createdAt == request.time;

      // Signed-in users may bump reply counter or add a like; admins may edit any field.
      allow update: if isAdmin()
        || (signedIn()
          && (
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyCount'])
              && request.resource.data.replyCount == resource.data.replyCount + 1)
            ||
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
              && request.resource.data.likes == resource.data.get('likes', 0) + 1)
            ||
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyCount'])
              && request.resource.data.replyCount == resource.data.replyCount - 1)
          )
        );

      // Author or admin can delete a thread.
      allow delete: if isOwner(resource.data.authorUid) || isAdmin();

      match /replies/{replyId} {
        allow read: if true;

        allow create: if isAdmin() || (signedIn()
          && isOwner(request.resource.data.authorUid)
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 2000
          && request.resource.data.get('likes', 0) == 0
          && request.resource.data.createdAt == request.time);

        // Author or admin can update/delete replies.
        allow update, delete: if isOwner(resource.data.authorUid) || isAdmin();
      }
    }

    // News: public read; authenticated users can submit news articles;
    // Admins or authors can delete or edit.
    match /news/{newsId} {
      allow read: if true;

      allow create: if isEmailUser()
        && (isOwner(request.resource.data.authorUid) || isAdmin())
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 160
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 8000
        && request.resource.data.category in ['Official', 'Leaks', 'Rumors', 'Community']
        && request.resource.data.get('sourceLink', '') is string
        && request.resource.data.isApproved is bool
        && (request.resource.data.isApproved == false || isAdmin())
        && request.resource.data.dateAdded != null;

      allow update: if isAdmin() || (
        signedIn()
        && resource.data.authorUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 160
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 8000
        && request.resource.data.category in ['Official', 'Leaks', 'Rumors', 'Community']
        && request.resource.data.get('sourceLink', '') is string
        && request.resource.data.isApproved == resource.data.isApproved
        && request.resource.data.authorUid == resource.data.authorUid
      );

      allow delete: if isAdmin() || (signedIn() && resource.data.authorUid == request.auth.uid);
    }
    // User Achievements (Manual Tracker)
    match /user_achievements/{achievementId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.game is string
        && request.resource.data.dateGot is string
        && request.resource.data.platform in ['steam', 'xbox', 'playstation', 'Steam', 'Xbox', 'PlayStation']
        && request.resource.data.completed == true
        && request.resource.data.createdAt == request.time;
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }
  }
}

