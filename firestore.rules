rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Email-authenticated (non-anonymous) user
    function isEmailUser() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Admin: role == 'Admin' in the users collection (checked via Firestore read)
    // Use custom claim 'admin: true' for server-side enforcement without extra reads.
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    // Walkthroughs: public reads, email-auth users can submit (approved defaults to false),
    // admins can approve/delete, anyone can like.
    match /walkthroughs/{walkthroughId} {
      // Public can read approved walkthroughs; admins can read all.
      allow read: if resource.data.approved == true || isAdmin();

      // Email-auth users can submit a new walkthrough (must default to approved:false).
      allow create: if isEmailUser()
        && request.resource.data.approved == false
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.get('summary', '').size() <= 400
        && request.resource.data.get('steps', []) is list;

      // Admins can approve (flip approved to true) or edit.
      allow update: if isAdmin()
        || (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
          && request.resource.data.likes == resource.data.get('likes', 0) + 1);

      allow delete: if isAdmin();
    }

    // Users: public reads, owner CRUD, admin can delete any user.
    match /users/{userId} {
      allow read: if true;

      allow create: if isAdmin() || (isOwner(userId)
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 24
        && request.resource.data.username.matches('^[a-zA-Z0-9_]+$')
        && request.resource.data.usernameLower == request.resource.data.username.lower()
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 60
        && request.resource.data.get('bio', '').size() <= 400
        && request.resource.data.get('location', '').size() <= 80
        && request.resource.data.role == 'Member';

      allow update: if isAdmin() || (isOwner(userId)
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['username', 'usernameLower', 'displayName', 'bio', 'location'])
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 24
        && request.resource.data.username.matches('^[a-zA-Z0-9_]+$')
        && request.resource.data.usernameLower == request.resource.data.username.lower()
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 60
        && request.resource.data.get('bio', '').size() <= 400
        && request.resource.data.get('location', '').size() <= 80);

      // Owner or admin can delete a user document.
      allow delete: if isOwner(userId) || isAdmin();

      match /manualAchievements/{achievementId} {
        allow read: if isAdmin() || isOwner(userId);

        allow create: if isAdmin() || isOwner(userId)
          && request.resource.data.platform == 'manual'
          && request.resource.data.gameTitle is string
          && request.resource.data.gameTitle.size() > 0
          && request.resource.data.gameTitle.size() <= 120
          && request.resource.data.achievementName is string
          && request.resource.data.achievementName.size() > 0
          && request.resource.data.achievementName.size() <= 120
          && request.resource.data.get('description', '').size() <= 500
          && request.resource.data.unlocked == false
          && request.resource.data.completedAt == null
          && request.resource.data.createdAt == request.time;

        allow update: if isAdmin() || isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unlocked', 'completedAt'])
          && (request.resource.data.unlocked
            ? request.resource.data.completedAt == request.time
            : request.resource.data.completedAt == null);

        allow delete: if isAdmin() || isOwner(userId);
      }
    }

    match /threads/{threadId} {
      allow read: if true;

      allow create: if signedIn()
        && (isOwner(request.resource.data.authorUid) || isAdmin())
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 4000
        && request.resource.data.category in ['General', 'Guides', 'Tech', 'News', 'Off-topic']
        && request.resource.data.replyCount == 0
        && request.resource.data.createdAt == request.time;

      // Signed-in users may bump reply counter or add a like; admins may edit any field.
      allow update: if isAdmin()
        || (signedIn()
          && (
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyCount'])
              && request.resource.data.replyCount == resource.data.replyCount + 1)
            ||
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
              && request.resource.data.likes == resource.data.get('likes', 0) + 1)
            ||
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyCount'])
              && request.resource.data.replyCount == resource.data.replyCount - 1)
          )
        );

      // Author or admin can delete a thread.
      allow delete: if isOwner(resource.data.authorUid) || isAdmin();

      match /replies/{replyId} {
        allow read: if true;

        allow create: if isAdmin() || (signedIn()
          && isOwner(request.resource.data.authorUid)
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 2000
          && request.resource.data.createdAt == request.time);

        // Author or admin can update/delete replies.
        allow update, delete: if isOwner(resource.data.authorUid) || isAdmin();
      }
    }
  }
}

