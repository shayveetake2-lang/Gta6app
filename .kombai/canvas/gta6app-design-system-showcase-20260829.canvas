 group\">\n                    <p class=\"atlas-micro m-0 text-[var(--atlas-cyan)]\" data-kid=\"1-2-5-1-1-1\" data-name=\"section metadata label\">\n                        03 / composition\n                    </p>\n                    <h2 class=\"mt-2 mb-0 text-xl font-normal text-white\" data-kid=\"1-2-5-1-1-2\" data-name=\"section title\" id=\"editorial-title\">\n                        Editorial surfaces\n                    </h2>\n                </div>\n                <span class=\"atlas-code hidden sm:block\" data-kid=\"1-2-5-1-2\" data-name=\"description tag\">\n                    dense, breathable, accountable\n                </span>\n            </div>\n            <div class=\"atlas-editorial-grid grid grid-cols-[1.08fr_.92fr] gap-5\" data-kid=\"1-2-5-2\" data-name=\"editorial grid\">\n                <div class=\"space-y-4\" data-kid=\"1-2-5-2-1\" data-name=\"editorial content column\">\n                    <article class=\"atlas-panel overflow-hidden\" data-kid=\"1-2-5-2-1-1\" data-name=\"featured article card\">\n                        <div class=\"flex items-center justify-between gap-3 border-b border-[var(--atlas-border)] px-5 py-4\" data-kid=\"1-2-5-2-1-1-1\" data-name=\"card header\">\n                            <div class=\"flex items-center gap-2\" data-kid=\"1-2-5-2-1-1-1-1\" data-name=\"badge container\">\n                                <span class=\"atlas-badge\" data-kid=\"1-2-5-2-1-1-1-1-1\" data-name=\"status badge\" style=\"background:#059669;\">\n                                    Official\n                                </span>\n                                <span class=\"atlas-micro\" data-kid=\"1-2-5-2-1-1-1-1-2\" data-name=\"meta text\">\n                                    source / Rockstar Games\n                                </span>\n                            </div>\n                            <span class=\"atlas-code\" data-kid=\"1-2-5-2-1-1-1-2\" data-name=\"date text\">\n                                27 Aug 2026\n                            </span>\n                        </div>\n                        <div class=\"p-5 md:p-6\" data-kid=\"1-2-5-2-1-1-2\" data-name=\"card content\">\n                            <div class=\"mb-5 flex items-start justify-between gap-4\" data-kid=\"1-2-5-2-1-1-2-1\" data-name=\"content header\">\n                                <div data-kid=\"1-2-5-2-1-1-2-1-1\" data-name=\"text group\">\n                                    <p class=\"atlas-micro m-0 text-[var(--atlas-pink)]\" data-kid=\"1-2-5-2-1-1-2-1-1-1\" data-name=\"eyebrow label\">\n                                        featured signal\n                                    </p>\n                                    <h3 class=\"mt-2 mb-0 max-w-[18ch] text-2xl font-normal leading-tight text-white\" data-kid=\"1-2-5-2-1-1-2-1-1-2\" data-name=\"card title\">\n                                        Extended Look: Leonida after dark\n                                    </h3>\n                                </div>\n                                <span aria-hidden=\"true\" class=\"text-2xl\" data-kid=\"1-2-5-2-1-1-2-1-2\" data-name=\"decorator icon\">\n                                    ▥\n                                </span>\n                            </div>\n                            <p class=\"max-w-[58ch] text-sm leading-[1.55] text-[var(--atlas-muted)]\" data-kid=\"1-2-5-2-1-1-2-2\" data-name=\"card description\">\n                                A new official media drop moves through neon coastlines, wet streets, and the wider state beyond Vice City. Here is the signal desk’s first pass.\n                            </p>\n                            <div class=\"mt-5 rounded-[9px] border border-[var(--atlas-border)] bg-[var(--atlas-raised)] p-4\" data-kid=\"1-2-5-2-1-1-2-3\" data-name=\"excerpt block\">\n                                <p class=\"atlas-micro m-0 text-[var(--atlas-cyan)]\" data-kid=\"1-2-5-2-1-1-2-3-1\" data-name=\"excerpt label\">\n                                    raised content excerpt\n                                </p>\n                                <p class=\"mt-3 mb-0 text-sm leading-[1.6] text-white\" data-kid=\"1-2-5-2-1-1-2-3-2\" data-name=\"excerpt text\">\n                                    “The city reads differently after sunset: businesses, waterways, and the spaces between them become part of the route.”\n                                </p>\n                            </div>\n                            <div class=\"mt-5 flex items-center justify-between gap-4 border-t border-[var(--atlas-border)] pt-4\" data-kid=\"1-2-5-2-1-1-2-4\" data-name=\"card footer\">\n                                <span class=\"text-xs text-[var(--atlas-muted)]\" data-kid=\"1-2-5-2-1-1-2-4-1\" data-name=\"byline text\">\n                                    By\n                                    <b class=\"text-white\" data-kid=\"1-2-5-2-1-1-2-4-1-1\" data-name=\"author handle\">\n                                        @signaldesk\n                                    </b>\n                                    · breakdown · 4 min read\n                                </span>\n                                <button class=\"atlas-link border-0 bg-transparent p-0 text-xs font-semibold text-[var(--atlas-cyan)]\" data-kid=\"1-2-5-2-1-1-2-4-2\" data-name=\"read more link\">\n                                    Read breakdown →\n                                </button>\n                            </div>\n                        </div>\n                    </article>\n                    <div class=\"rounded-[9px] border border-[#ea580c] px-4 py-4\" data-kid=\"1-2-5-2-1-2\" data-name=\"warning block\" style=\"background:rgba(234,88,12,.12);\">\n                        <div class=\"flex items-start gap-3\" data-kid=\"1-2-5-2-1-2-1\" data-name=\"warning container\">\n                            <span class=\"text-lg text-[#ff9d66]\" data-kid=\"1-2-5-2-1-2-1-1\" data-name=\"warning icon\">\n                                ⚠\n                            </span>\n                            <div data-kid=\"1-2-5-2-1-2-1-2\" data-name=\"warning text group\">\n                                <p class=\"m-0 text-sm font-semibold text-[#ff9d66]\" data-kid=\"1-2-5-2-1-2-1-2-1\" data-name=\"warning title\">\n                                    Know the difference\n                                </p>\n                                <p class=\"mt-1 mb-0 text-xs leading-[1.5] text-white/75\" data-kid=\"1-2-5-2-1-2-1-2-2\" data-name=\"warning description\">\n                                    Rumour Watch keeps predictions and unverified claims separate from official announcements. If Rockstar has not announced it, it is not confirmed.\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"space-y-3\" data-kid=\"1-2-5-2-2\" data-name=\"discussion panel\">\n                    <div class=\"mb-3 flex items-end justify-between border-b border-[var(--atlas-border)] pb-3\" data-kid=\"1-2-5-2-2-1\" data-name=\"panel header\">\n                        <div data-kid=\"1-2-5-2-2-1-1\" data-name=\"panel title group\">\n                            <p class=\"atlas-micro m-0 text-[var(--atlas-pink)]\" data-kid=\"1-2-5-2-2-1-1-1\" data-name=\"panel category label\">\n                                Active discussions\n                            </p>\n                            <p class=\"mt-2 mb-0 text-sm text-[var(--atlas-muted)]\" data-kid=\"1-2-5-2-2-1-1-2\" data-name=\"panel description\">\n                                Forum rows keep the conversation scannable.\n                            </p>\n                        </div>\n                        <span class=\"atlas-code\" data-kid=\"1-2-5-2-2-1-2\" data-name=\"thread count tag\">\n                            3 threads\n                        </span>\n                    </div>\n                    <a class=\"atlas-thread atlas-compact flex items-start gap-3 p-4 no-underline\" data-kid=\"1-2-5-2-2-2\" data-name=\"discussion thread link\" href=\"#\">\n                        <span class=\"grid h-10 w-10 shrink-0 place-items-center rounded-full bg-[var(--atlas-raised)] text-sm font-bold text-white\" data-kid=\"1-2-5-2-2-2-1\" data-name=\"thread icon\">\n                            NV\n                        </span>\n                        <span class=\"min-w-0 flex-1\" data-kid=\"1-2-5-2-2-2-2\" data-name=\"thread details\">\n                            <span class=\"block truncate text-sm font-semibold text-white\" data-kid=\"1-2-5-2-2-2-2-1\" data-name=\"thread title\">\n                                Is the Keys route built for solo players?\n                            </span>\n                            <span class=\"mt-2 block text-xs text-[var(--atlas-muted)]\" data-kid=\"1-2-5-2-2-2-2-2\" data-name=\"thread meta\">\n                                <b class=\"atlas-badge mr-1\" data-kid=\"1-2-5-2-2-2-2-2-1\" data-name=\"thread badge\" style=\"background:#64748b;font-size:.62rem;\">\n                                    General\n                                </b>\n                                @nova · 12 min ago\n                            </span>\n                        </span>\n                        <span class=\"shrink-0 text-center text-xs text-[var(--atlas-muted)]\" data-kid=\"1-2-5-2-2-2-3\" data-name=\"thread reply count\">\n                            <b class=\"block text-base text-white\" data-kid=\"1-2-5-2-2-2-3-1\" data-name=\"reply count value\">\n                                18\n                            </b>\n                            replies\n                        </span>\n                    </a>\n                    <a class=\"atlas-thread atlas-compact flex items-start gap-3 p-4 no-underline\" data-kid=\"1-2-5-2-2-3\" data-name=\"discussion thread link\" href=\"#\">\n                        <span class=\"grid h-10 w-10 shrink-0 place-items-center rounded-full bg-[var(--atlas-raised)] text-sm font-bold text-white\" data-kid=\"1-2-5-2-2-3-1\" data-name=\"thread icon\">\n                            MC\n                        </span>\n                        <span class=\"min-w-0 flex-1\" data-kid=\"1-2-5-2-2-3-2\" data-name=\"thread details\">\n                            <span class=\"block truncate text-sm font-semibold text-white\" data-kid=\"1-2-5-2-2-3-2-1\" data-name=\"thread title\">\n                                Which Drift Race gives the cleanest line?\n                            </span>\n                            <span class=\"mt-2 block text-xs text-[var(--atlas-muted)]\" data-kid=\"1-2-5-2-2-3-2-2\" data-name=\"thread meta\">\n                                <b class=\"atlas-badge mr-1\" data-kid=\"1-2-5-2-2-3-2-2-1\" data-name=\"thread badge\" style=\"background:#f59e0b;color:#1c0a00;font-size:.62rem;\">\n                                    Races\n                                </b>\n                                @midnightclub · 1 hr ago\n                            </span>\n                        </span>\n                        <span class=\"shrink-0 text-center text-xs text-[var(--atlas-muted)]\" data-kid=\"1-2-5-2-2-3-3\" data-name=\"thread reply count\">\n                            <b class=\"block text-base text-white\" data-kid=\"1-2-5-2-2-3-3-1\" data-name=\"reply count value\">\n                                7\n                            </b>\n                            replies\n                        </span>\n                    </a>\n                    <a class=\"atlas-thread atlas-compact flex items-start gap-3 p-4 no-underline\" data-kid=\"1-2-5-2-2-4\" data-name=\"discussion thread link\" href=\"#\">\n                        <span class=\"grid h-10 w-10 shrink-0 place-items-center rounded-full bg-[var(--atlas-raised)] text-sm font-bold text-white\" data-kid=\"1-2-5-2-2-4-1\" data-name=\"thread icon\">\n                            LC\n                        </span>\n                        <span class=\"min-w-0 flex-1\" data-kid=\"1-2-5-2-2-4-2\" data-name=\"thread details\">\n                            <span class=\"block truncate text-sm font-semibold text-white\" data-kid=\"1-2-5-2-2-4-2-1\" data-name=\"thread title\">\n                                Lucia’s first move after the prison gate\n                            </span>\n                            <span class=\"mt-2 block text-xs text-[var(--atlas-muted)]\" data-kid=\"1-2-5-2-2-4-2-2\" data-name=\"thread meta\">\n                                <b class=\"atlas-badge mr-1\" data-kid=\"1-2-5-2-2-4-2-2-1\" data-name=\"thread badge\" style=\"background:#2563eb;font-size:.62rem;\">\n                                    Theory\n                                </b>\n                                @leonidacartographer · 2 hr ago\n                            </span>\n                        </span>\n                        <span class=\"shrink-0 text-center text-xs text-[var(--atlas-muted)]\" data-kid=\"1-2-5-2-2-4-3\" data-name=\"thread reply count\">\n                            <b class=\"block text-base text-white\" data-kid=\"1-2-5-2-2-4-3-1\" data-name=\"reply count value\">\n                                31\n                            </b>\n                            replies\n                        </span>\n                    </a>\n                    <div class=\"atlas-empty px-4 py-6 text-center\" data-kid=\"1-2-5-2-2-5\" data-name=\"empty state specimen\">\n                        <p class=\"atlas-micro m-0\" data-kid=\"1-2-5-2-2-5-1\" data-name=\"specimen label\">\n                            empty-state specimen\n                        </p>\n                        <p class=\"mt-2 mb-0 text-sm text-[var(--atlas-muted)]\" data-kid=\"1-2-5-2-2-5-2\" data-name=\"specimen text\">\n                            No pinned discussions yet.\n                        </p>\n                        <span class=\"atlas-code mt-2 block\" data-kid=\"1-2-5-2-2-5-3\" data-name=\"specimen code\">\n                            border: 1px dashed\n                        </span>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"responsive-title\" class=\"pt-10\" data-kid=\"1-2-6\" data-name=\"responsive section\">\n            <div class=\"mb-4 flex items-end justify-between gap-4 border-b border-[var(--atlas-border)] pb-3\" data-kid=\"1-2-6-1\" data-name=\"responsive section header\">\n                <div data-kid=\"1-2-6-1-1\" data-name=\"title group\">\n                    <p class=\"atlas-micro m-0 text-[var(--atlas-pink)]\" data-kid=\"1-2-6-1-1-1\" data-name=\"section metadata label\">\n                        04 / responsive behavior\n                    </p>\n                    <h2 class=\"mt-2 mb-0 text-xl font-normal text-white\" data-kid=\"1-2-6-1-1-2\" data-name=\"section title\" id=\"responsive-title\">\n                        Same signal, different frame\n                    </h2>\n                </div>\n                <span class=\"atlas-code hidden sm:block\" data-kid=\"1-2-6-1-2\" data-name=\"breakpoint tag\">\n                    breakpoint: 860px\n                </span>\n            </div>\n            <div class=\"atlas-panel p-5 md:p-6\" data-kid=\"1-2-6-2\" data-name=\"responsive documentation panel\">\n                <div class=\"atlas-responsive-grid grid grid-cols-3 gap-0 divide-x divide-[var(--atlas-border)]\" data-kid=\"1-2-6-2-1\" data-name=\"documentation grid\">\n                    <div class=\"pr-5\" data-kid=\"1-2-6-2-1-1\" data-name=\"responsive column\">\n                        <p class=\"atlas-micro m-0 text-[var(--atlas-cyan)]\" data-kid=\"1-2-6-2-1-1-1\" data-name=\"column label\">\n                            desktop / > 860px\n                        </p>\n                        <p class=\"mt-3 mb-0 text-sm font-semibold text-white\" data-kid=\"1-2-6-2-1-1-2\" data-name=\"column title\">\n                            Horizontal nav + inline search\n                        </p>\n                        <p class=\"mt-2 mb-0 text-xs leading-[1.5] text-[var(--atlas-muted)]\" data-kid=\"1-2-6-2-1-1-3\" data-name=\"column description\">\n                            The topbar stays in one 60px row. Walkthrough detail can open into a main column and 300px sidecard.\n                        </p>\n                    </div>\n                    <div class=\"px-5\" data-kid=\"1-2-6-2-1-2\" data-name=\"responsive column\">\n                        <p class=\"atlas-micro m-0 text-[var(--atlas-pink)]\" data-kid=\"1-2-6-2-1-2-1\" data-name=\"column label\">\n                            860px / split\n                        </p>\n                        <p class=\"mt-3 mb-0 text-sm font-semibold text-white\" data-kid=\"1-2-6-2-1-2-2\" data-name=\"column title\">\n                            Nav becomes a drawer\n                        </p>\n                        <p class=\"mt-2 mb-0 text-xs leading-[1.5] text-[var(--atlas-muted)]\" data-kid=\"1-2-6-2-1-2-3\" data-name=\"column description\">\n                            Search moves to a full-width row, the theme control joins the menu, and the scrim protects context.\n                        </p>\n                    </div>\n                    <div class=\"pl-5\" data-kid=\"1-2-6-2-1-3\" data-name=\"responsive column\">\n                        <p class=\"atlas-micro m-0 text-[var(--atlas-cyan)]\" data-kid=\"1-2-6-2-1-3-1\" data-name=\"column label\">\n                            mobile / touch\n                        </p>\n                        <p class=\"mt-3 mb-0 text-sm font-semibold text-white\" data-kid=\"1-2-6-2-1-3-2\" data-name=\"column title\">\n                            Fixed tab rail + safe area\n                        </p>\n                        <p class=\"mt-2 mb-0 text-xs leading-[1.5] text-[var(--atlas-muted)]\" data-kid=\"1-2-6-2-1-3-3\" data-name=\"column description\">\n                            The bottom tab bar keeps Home, Guides, News, and Forum one thumb away without obscuring content.\n                        </p>\n                    </div>\n                </div>\n                <div class=\"mt-6 border-t border-[var(--atlas-border)] pt-5\" data-kid=\"1-2-6-2-2\" data-name=\"mobile rail example\">\n                    <div class=\"mb-3 flex items-center justify-between\" data-kid=\"1-2-6-2-2-1\" data-name=\"rail header\">\n                        <p class=\"atlas-micro m-0\" data-kid=\"1-2-6-2-2-1-1\" data-name=\"rail label\">\n                            mobile tab rail specimen\n                        </p>\n                        <span class=\"atlas-code\" data-kid=\"1-2-6-2-2-1-2\" data-name=\"rail size tag\">\n                            tabbar-h: 58px\n                        </span>\n                    </div>\n                    <nav aria-label=\"Mobile tab specimen\" class=\"atlas-mobile-tabs grid grid-cols-4 rounded-[9px] border border-[var(--atlas-border)] bg-[var(--atlas-surface)]\" data-kid=\"1-2-6-2-2-2\" data-name=\"mobile tab rail\">\n                        <a class=\"flex min-h-[58px] flex-col items-center justify-center gap-1 rounded-[9px] text-xs font-semibold text-white no-underline\" data-kid=\"1-2-6-2-2-2-1\" data-name=\"tab link\" href=\"#\" style=\"background:var(--atlas-pink);\">\n                            <span class=\"text-lg leading-none\" data-kid=\"1-2-6-2-2-2-1-1\" data-name=\"tab icon\">\n                                ⌂\n                            </span>\n                            Home\n                        </a>\n                        <a class=\"flex min-h-[58px] flex-col items-center justify-center gap-1 text-xs font-semibold text-[var(--atlas-muted)] no-underline\" data-kid=\"1-2-6-2-2-2-2\" data-name=\"tab link\" href=\"#\">\n                            <span class=\"text-lg leading-none text-[var(--atlas-cyan)]\" data-kid=\"1-2-6-2-2-2-2-1\" data-name=\"tab icon\">\n                                ▤\n                            </span>\n                            Guides\n                        </a>\n                        <a class=\"flex min-h-[58px] flex-col items-center justify-center gap-1 text-xs font-semibold text-[var(--atlas-muted)] no-underline\" data-kid=\"1-2-6-2-2-2-3\" data-name=\"tab link\" href=\"#\">\n                            <span class=\"text-lg leading-none text-[var(--atlas-cyan)]\" data-kid=\"1-2-6-2-2-2-3-1\" data-name=\"tab icon\">\n                                ▥\n                            </span>\n                            News\n                        </a>\n                        <a class=\"flex min-h-[58px] flex-col items-center justify-center gap-1 text-xs font-semibold text-[var(--atlas-muted)] no-underline\" data-kid=\"1-2-6-2-2-2-4\" data-name=\"tab link\" href=\"#\">\n                            <span class=\"text-lg leading-none text-[var(--atlas-cyan)]\" data-kid=\"1-2-6-2-2-2-4-1\" data-name=\"tab icon\">\n                                ▣\n                            </span>\n                            Forum\n                        </a>\n                    </nav>\n                </div>\n            </div>\n        </section>\n    </main>\n    <footer class=\"border-t border-[var(--atlas-border)] bg-[var(--atlas-surface)]\" data-kid=\"1-3\" data-name=\"footer section\">\n        <div class=\"atlas-footer-line mx-auto flex max-w-[1140px] items-center justify-between gap-4 px-4 py-5\" data-kid=\"1-3-1\" data-name=\"footer inner container\">\n            <div data-kid=\"1-3-1-1\" data-name=\"footer branding\">\n                <p class=\"m-0 text-sm font-semibold text-white\" data-kid=\"1-3-1-1-1\" data-name=\"brand title\">\n                    Built for the Leonida signal desk\n                </p>\n                <p class=\"mt-1 mb-0 text-xs text-[var(--atlas-muted)]\" data-kid=\"1-3-1-1-2\" data-name=\"brand description\">\n                    A living reference for the community intelligence hub.\n                </p>\n            </div>\n            <div class=\"flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-[var(--atlas-muted)]\" data-kid=\"1-3-1-2\" data-name=\"footer feature list\">\n                <span data-kid=\"1-3-1-2-1\" data-name=\"feature item\">\n                    <i class=\"mr-1 not-italic text-[var(--atlas-cyan)]\" data-kid=\"1-3-1-2-1-1\" data-name=\"bullet point\">\n                        ●\n                    </i>\n                    CSS-only motion\n                </span>\n                <span data-kid=\"1-3-1-2-2\" data-name=\"feature item\">\n                    <i class=\"mr-1 not-italic text-[var(--atlas-cyan)]\" data-kid=\"1-3-1-2-2-1\" data-name=\"bullet point\">\n                        ●\n                    </i>\n                    system sans\n                </span>\n                <span data-kid=\"1-3-1-2-3\" data-name=\"feature item\">\n                    <i class=\"mr-1 not-italic text-[var(--atlas-pink)]\" data-kid=\"1-3-1-2-3-1\" data-name=\"bullet point\">\n                        ●\n                    </i>\n                    light mode mapped\n                </span>\n                <span data-kid=\"1-3-1-2-4\" data-name=\"feature item\">\n                    <i class=\"mr-1 not-italic text-[var(--atlas-cyan)]\" data-kid=\"1-3-1-2-4-1\" data-name=\"bullet point\">\n                        ●\n                    </i>\n                    safe-area aware\n                </span>\n            </div>\n        </div>\n    </footer>\n</div>\n",
