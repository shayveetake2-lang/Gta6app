ner\">\n                                        <span class=\"grid h-6 w-6 shrink-0 place-items-center rounded-full bg-[#2ed573] text-sm font-bold text-[#08131a]\" data-kid=\"1-2-4-2-1-2-2-2-2-1-1\" data-name=\"success icon\">\n                                            ✓\n                                        </span>\n                                        <div data-kid=\"1-2-4-2-1-2-2-2-2-1-2\" data-name=\"text container\">\n                                            <p class=\"m-0 text-sm font-semibold text-[#6ee7a8]\" data-kid=\"1-2-4-2-1-2-2-2-2-1-2-1\" data-name=\"success title\">\n                                                Profile saved.\n                                            </p>\n                                            <p class=\"mt-1 mb-0 text-xs text-[var(--atlas-muted)]\" data-kid=\"1-2-4-2-1-2-2-2-2-1-2-2\" data-name=\"success description\">\n                                                Your forum identity is ready for the next discussion.\n                                            </p>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            <div data-kid=\"1-2-4-2-1-2-2-3\" data-name=\"touch target section\">\n                                <p class=\"atlas-micro mb-2\" data-kid=\"1-2-4-2-1-2-2-3-1\" data-name=\"section label\">\n                                    touch cue\n                                </p>\n                                <div class=\"flex items-center gap-3\" data-kid=\"1-2-4-2-1-2-2-3-2\" data-name=\"touch cue\">\n                                    <button class=\"atlas-btn atlas-btn-primary px-5\" data-kid=\"1-2-4-2-1-2-2-3-2-1\" data-name=\"button example\">\n                                        44px\n                                    </button>\n                                    <span class=\"text-xs text-[var(--atlas-muted)]\" data-kid=\"1-2-4-2-1-2-2-3