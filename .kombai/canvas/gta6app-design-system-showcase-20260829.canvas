      },
      "html": "<style>\n    .atlas-shell { --atlas-bg: #0b0914; --atlas-surface: #151126; --atlas-raised: #211a39; --atlas-border: #2c224d; --atlas-focus: #00f0ff; --atlas-text: #ffffff; --atlas-muted: #8490a6; --atlas-pink: #ff007f; --atlas-cyan: #00f0ff; --atlas-danger: #ff4757; --atlas-success: #2ed573; --atlas-warn: #ea580c; --atlas-font: system-ui, -apple-system, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif; font-family: var(--atlas-font); color: var(--atlas-text); background: var(--atlas-bg); }\n  .atlas-shell * { box-sizing: border-box; }\n  .atlas-shell button, .atlas-shell input { font: inherit; }\n  .atlas-grid { background-image: linear-gradient(rgba(44,34,77,.16) 1px, transparent 1px), linear-gradient(90deg, rgba(44,34,77,.16) 1px, transparent 1px); background-size: 32px 32px; }\n  .atlas-panel { background: var(--atlas-surface); border: 1px solid var(--atlas-border); border-radius: 14px; }\n  .atlas-compact { background: var(--atlas-surface); border: 1px solid var(--atlas-border); border-radius: 9px; }\n  .atlas-micro { color: var(--atlas-muted); font-size: .68rem; font-weight: 700; letter-spacing: .14em; line-height: 1.2; text-transform: uppercase; }\n  .atlas-code { color: var(--atlas-muted); font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-size: .72rem; }\n  .atlas-link, .atlas-action, .atlas-nav-link, .atlas-chip, .atlas-icon-button { transition: transform .15s ease, background-color .15s ease, border-color .15s ease, color .15s ease, box-shadow .15s ease; }\n  .atlas-link:hover, .atlas-nav-link:hover, .atlas-action:hover, .atlas-chip:hover, .atlas-icon-button:hover { transform: translateY(-1px); }\n  .atlas-nav-link:focus-visible, .atlas-action:focus-visible, .atlas-chip:focus-visible, .atlas-icon-button:focus-visible, .atlas-search-input:focus-visible { outline: 2px solid var(--atlas-pink); outline-offset: 2px; border-radius: 6px; }\n  .atlas-nav-toggle { display: none; }\n  .atlas-search-input::placeholder { color: var(--atlas-muted); opacity: 1; }\n  .atlas-ruler { position: relative; height: 44px; border: 1px solid var(--atlas-focus); border-radius: 9px; background: rgba(0,240,255,.06); }\n  .atlas-ruler:before, .atlas-ruler:after { content: ''; position: absolute; top: 9px; bottom: 9px; width: 1px; background: var(--atlas-focus); }\n  .atlas-ruler:before { left: 12px; } .atlas-ruler:after { right: 12px; }\n  .atlas-rule { height: 1px; background: var(--atlas-border); }\n  .atlas-badge { display: inline-flex; align-items: center; min-height: 22px; padding: .2rem .5rem; border-radius: 999px; color: #fff; font-size: .7rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; white-space: nowrap; }\n  .atlas-btn { min-height: 44px; border: 1px solid var(--atlas-border); border-radius: 999px; padding: .65rem 1.1rem; font-weight: 600; cursor: pointer; }\n  .atlas-btn-primary { background: var(--atlas-pink); border-color: var(--atlas-pink); color: #fff; box-shadow: 0 0 18px rgba(255,0,127,.34); }\n  .atlas-btn-ghost { background: transparent; border-color: var(--atlas-cyan); color: var(--atlas-cyan); }\n  .atlas-btn-neutral { background: var(--atlas-surface); color: var(--atlas-text); }\n  .atlas-btn-disabled { background: var(--atlas-raised); border-color: var(--atlas-border); color: var(--atlas-muted); cursor: not-allowed; opacity: .55; }\n  .atlas-chip { min-height: 32px; border: 1px solid var(--atlas-border); border-radius: 999px; padding: .45rem .9rem; background: var(--atlas-surface); color: var(--atlas-muted); cursor: pointer; font-size: .88rem; }\n  .atlas-chip-active { background: var(--atlas-pink); border-color: var(--atlas-pink); color: #fff; }\n  .atlas-thread { transition: transform .15s ease, border-color .15s ease; }\n  .atlas-thread:hover { transform: translateY(-2px); border-color: var(--atlas-cyan); }\n  .atlas-empty { border: 1px dashed var(--atlas-border); border-radius: 14px; }\n  .atlas-mobile-tabs { display: none; }\n  @media (max-width: 860px) {\n    .atlas-topbar-inner { flex-wrap: wrap; padding-top: .5rem; padding-bottom: .5rem; }\n    .atlas-nav-toggle { display: grid; }\n    .atlas-nav { display: none; width: 100%; order: 5; padding: 1rem; background: var(--atlas-surface); border: 1px solid var(--atlas-border); border-radius: 9px; }\n    .atlas-nav-list { flex-direction: column; }\n    .atlas-nav-link { width: 100%; border-radius: 9px; }\n    .atlas-search-wrap { flex: 1 1 100%; order: 4; }\n    .atlas-hero-grid, .atlas-foundations-grid, .atlas-controls-grid, .atlas-editorial-grid { grid-template-columns: 1fr !important; }\n    .atlas-color-grid { grid-template-columns: repeat(2, minmax(0, 1fr)) !important; }\n    .atlas-control-demo-grid { grid-template-columns: 1fr !important; }\n    .atlas-responsive-grid { grid-template-columns: 1fr !important; }\n    .atlas-footer-line { align-items: flex-start !important; flex-direction: column; }\n    .atlas-mobile-tabs { display: grid; }\n  }\n</style>\n<div class=\"atlas-shell atlas-grid min-h-screen\" data-kid=\"1\" data-name=\"shell wrapper\" style=\"background-color: var(--atlas-bg);\">\n    <header class=\"sticky top-0 z-20 border-b border-[var(--atlas-border)] backdrop-blur-[10px]\" data-kid=\"1-1\" data-name=\"header bar\" style=\"background: color-mix(in srgb, var(--atlas-bg) 88%, transparent);\">\n        <div class=\"atlas-topbar-inner mx-auto flex min-h-[60px] max-w-[1140px] items-center gap-3 px-4\" data-kid=\"1-1-1\" data-name=\"header inner container\">\n            <button aria-label=\"Open navigation\" class=\"atlas-icon-button atlas-nav-toggle h-10 w-10 place-items-center border border-[var(--atlas-border)] bg-[var(--atlas-surface)] text-[var(--atlas-text)]\" data-kid=\"1-1-1-1\" data-name=\"navigation toggle button\">\n                <span class=\"text-lg\" data-kid=\"1-1-1-1-1\" data-name=\"hamburger menu icon\">\n                    ☰\n                </span>\n            </button>\n            <a aria-label=\"GTA6 Walkthrough home\" class=\"flex shrink-0 items-center gap-2 text-[1.05rem] no-underline\" data-kid=\"1-1-1-2\" data-name=\"logo link\" href=\"#\">\n                <span class=\"grid h-8 w-8 place-items-center rounded-[9px] text-[.78rem] font-extrabold tracking-[.5px] text-white\" data-kid=\"1-1-1-2-1\" data-name=\"brand mark\" style=\"background: linear-gradient(135deg, #ff007f, #00f0ff);\">\n                    G6\n                </span>\n                <span class=\"whitespace-nowrap\" data-kid=\"1-1-1-2-2\" data-name=\"brand name text\">\n                    GTA6\n                    <b class=\"font-extrabold text-[var(--atlas-pink)]\" data-kid=\"1-1-1-2-2-1\" data-name=\"brand suffix text\">\n                        Walkthrough\n                    </b>\n                </span>\n            </a>\n            <nav aria-label=\"Primary navigation\" class=\"atlas-nav ml-2\" data-kid=\"1-1-1-3\" data-name=\"primary navigation\">\n                <ul class=\"atlas-nav-list m-0 flex list-none items-center gap-1 p-0\" data-kid=\"1-1-1-3-1\" data-name=\"navigation list\">\n                    <li data-kid=\"1-1-1-3-1-1\" data-name=\"navigation item\">\n                        <a class=\"atlas-nav-link block rounded-full px-3 py-2 text-sm font-semibold text-[var(--atlas-muted)] no-underline hover:bg-[var(--atlas-raised)] hover:text-[var(--atlas-text)]\" data-kid=\"1-1-1-3-1-1-1\" data-name=\"navigation link\" href=\"#\">\n                            Home\n                        </a>\n                    </li>\n                    <li data-kid=\"1-1-1-3-1-2\" data-name=\"navigation item\">\n                        <a class=\"atlas-nav-link block rounded-full px-3 py-2 text-sm font-semibold text-[var(--atlas-muted)] no-underline hover:bg-[var(--atlas-raised)] hover:text-[var(--atlas-text)]\" data-kid=\"1-1-1-3-1-2-1\" data-name=\"navigation link\" href=\"#\">\n                            Walkthroughs\n                        </a>\n                    </li>\n                    <li data-kid=\"1-1-1-3-1-3\" data-name=\"navigation item\">\n                        <a class=\"atlas-nav-link block rounded-full px-3 py-2 text-sm font-semibold text-[var(--atlas-muted)] no-underline hover:bg-[var(--atlas-raised)] hover:text-[var(--atlas-text)]\" data-kid=\"1-1-1-3-1-3-1\" data-name=\"navigation link\" href=\"#\">\n                            News\n                        </a>\n                    </li>\n                    <li data-kid=\"1-1-1-3-1-4\" data-name=\"navigation item\">\n                        <a class=\"atlas-nav-link block rounded-full px-3 py-2 text-sm font-semibold text-[var(--atlas-muted)] no-underline hover:bg-[var(--atlas-raised)] hover:text-[var(--atlas-text)]\" data-kid=\"1-1-1-3-1-4-1\" data-name=\"navigation link\" href=\"#\">\n                            Forum\n                        </a>\n                    </li>\n                    <li data-kid=\"1-1-1-3-1-5\" data-name=\"navigation item\">\n                        <a aria-current=\"page\" class=\"atlas-nav-link block rounded-full px-3 py-2 text-sm font-semibold text-white no-underline\" data-kid=\"1-1-1-3-1-5-1\" data-name=\"navigation link\" href=\"#\" style=\"background: var(--atlas-pink);\">\n                            Atlas\n                        </a>\n                    </li>\n                </ul>\n            </nav>\n            <div class=\"atlas-search-wrap ml-auto flex min-w-0 flex-[0_1_260px] items-center gap-2\" data-kid=\"1-1-1-4\" data-name=\"utility search container\">\n                <label class=\"relative block w-full\" data-kid=\"1-1-1-4-1\" data-name=\"search label\">\n                    <span aria-hidden=\"true\" class=\"pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-sm text-[var(--atlas-muted)]\" data-kid=\"1-1-1-4-1-1\" data-name=\"search icon\">\n                        ⌕\n                    </span>\n                    <input aria-label=\"Search the system\" class=\"atlas-search-input h-10 w-full rounded-full border border-[var(--atlas-border)] bg-[var(--atlas-surface)] py-2 pl-9 pr-3 text-sm text-[var(--atlas-text)] outline-none focus:border-[var(--atlas-cyan)] focus:ring-2 focus:ring-[rgba(0,240,255,.18)]\" data-kid=\"1-1-1-4-1-2\" data-name=\"search input field\" placeholder=\"Search the system…\" type=\"search\"/>\n                </label>\n                <button aria-label=\"Toggle dark mode\" class=\"atlas-icon-button hidden h-10 shrink-0 items-center gap-2 rounded-[10px] border border-[var(--atlas-border)] bg-[var(--atlas-surface)] px-3 text-sm text-[var(--atlas-text)] md:flex\" data-kid=\"1-1-1-4-2\" data-name=\"dark mode toggle button\">\n                    <span class=\"text-base\" data-kid=\"1-1-1-4-2-1\" data-name=\"theme icon\">\n                        ◐\n                    </span>\n                    <span data-kid=\"1-1-1-4-2-2\" data-name=\"theme label\">\n                        Dark mode\n                    </span>\n                </button>\n                <span class=\"atlas-code hidden whitespace-nowrap md:inline\" data-kid=\"1-1-1-4-3\" data-name=\"version tag\">\n                    v0.13\n                </span>\n            </div>\n        </div>\n    </header>\n    <main class=\"mx-auto max-w-[1140px] px-4 pb-16 pt-7\" data-kid=\"1-2\" data-name=\"main content area\">\n        <div class=\"mb-4 flex items-center justify-between gap-4\" data-kid=\"1-2-1\" data-name=\"breadcrumb header section\">\n            <p class=\"atlas-micro m-0 text-[var(--atlas-cyan)]\" data-kid=\"1-2-1-1\" data-name=\"section metadata label\">\n                Component Atlas / Build 01\n            </p>\n            <p class=\"atlas-code m-0 hidden sm:block\" data-kid=\"1-2-1-2\" data-name=\"semantic state guide\">\n                semantic role\n                <span class=\"text-[var(--atlas-border)]\" data-kid=\"1-2-1-2-1\" data-name=\"separator\">\n                    /\n                </span>\n                source value\n                <span class=\"text-[var(--atlas-border)]\" data-kid=\"1-2-1-2-2\" data-name=\"separator\">\n                    /\n                </span>\n                interactive state\n            </p>\n        </div>\n        <section aria-labelledby=\"atlas-title\" class=\"atlas-hero-grid grid grid-cols-[1.08fr_.92fr] gap-5 border-y border-[var(--atlas-border)] py-8 md:py-10\" data-kid=\"1-2-2\" data-name=\"hero section\">\n            <div class=\"flex flex-col justify-center\" data-kid=\"1-2-2-1\" data-name=\"hero content column\">\n                <p class=\"atlas-micro mb-4 text-[var(--atlas-pink)]\" data-kid=\"1-2-2-1-1\" data-name=\"hero category label\">\n                    Readable by design\n                </p>\n                <h1 class=\"m-0 max-w-[12ch] text-[clamp(1.6rem,5vw,2.6rem)] font-normal leading-[1.15] tracking-[-.04em] text-white\" data-kid=\"1-2-2-1-2\" data-name=\"hero main title\" id=\"atlas-title\">\n                    One interface.\n                    <br data-kid=\"1-2-2-1-2-1\" data-name=\"line break\"/>\n                    <span class=\"text-[var(--atlas-cyan)]\" data-kid=\"1-2-2-1-2-2\" data-name=\"title highlight text\">\n                        Every signal.\n                    </span>\n                </h1>\n                <p class=\"mt-5 max-w-[56ch] text-base leading-[1.55] text-[var(--atlas-muted)]\" data-kid=\"1-2-2-1-3\" data-name=\"hero description text\">\n                    The Component Atlas turns official news, community theories, walkthroughs, and moderation states into one readable language for the Leonida signal desk.\n                </p>\n                <div class=\"mt-6 flex flex-wrap gap-2\" data-kid=\"1-2-2-1-4\" data-name=\"hero call-to-action group\">\n                    <button class=\"atlas-action atlas-btn atlas-btn-primary\" data-kid=\"1-2-2-1-4-1\" data-name=\"primary action button\" type=\"button\">\n                        Use the system\n                        <span aria-hidden=\"true\" data-kid=\"1-2-2-1-4-1-1\" data-name=\"external link arrow icon\">\n                            ↗\n                        </span>\n                    </button>\n                    <button class=\"atlas-action atlas-btn atlas-btn-ghost\" data-kid=\"1-2-2-1-4-2\" data-name=\"secondary action button\" type=\"button\">\n                        Read the rules\n                    </button>\n                </div>\n                <div class=\"mt-7 flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-[var(--atlas-border)] pt-4 text-xs text-[var(--atlas-muted)]\" data-kid=\"1-2-2-1-5\" data-name=\"hero metrics bar\">\n                    <span data-kid=\"1-2-2-1-5-1\" data-name=\"metric item\">\n                        <b class=\"mr-1 text-white\" data-kid=\"1-2-2-1-5-1-1\" data-name=\"metric value\">\n                            44px\n                        </b>\n                        touch target cue\n                    </span>\n                    <span data-kid=\"1-2-2-1-5-2\" data-name=\"metric item\">\n                        <b class=\"mr-1 text-white\" data-kid=\"1-2-2-1-5-2-1\" data-name=\"metric value\">\n                            860px\n                        </b>\n                        responsive split\n                    </span>\n                    <span data-kid=\"1-2-2-1-5-3\" data-name=\"metric item\">\n                        <b class=\"mr-1 text-white\" data-kid=\"1-2-2-1-5-3-1\" data-name=\"metric value\">\n                            02\n                        </b>\n                        mapped modes\n                    </span>\n                </div>\n            </div>\n            <div class=\"atlas-panel relative overflow-hidden p-5 md:p-6\" data-kid=\"1-2-2-2\" data-name=\"hero live preview panel\" style=\"background: linear-gradient(135deg, rgba(255,0,127,.10), rgba(0,240,255,.05) 48%, #151126);\">\n                <div aria-hidden=\"true\" class=\"absolute right-5 top-5 h-20 w-20 rounded-full border border-[rgba(0,240,255,.25)]\" data-kid=\"1-2-2-2-1\" data-name=\"decorative circle\">\n                </div>\n                <div class=\"relative\" data-kid=\"1-2-2-2-2\" data-name=\"live preview content container\">\n                    <div class=\"mb-7 flex items-center justify-between gap-3\" data-kid=\"1-2-2-2-2-1\" data-name=\"preview header\">\n                        <p class=\"atlas-micro m-0 text-[var(--atlas-cyan)]\" data-kid=\"1-2-2-2-2-1-1\" data-name=\"preview label\">\n                            Live token preview\n                        </p>\n                        <span class=\"atlas-code\" data-kid=\"1-2-2-2-2-1-2\" data-name=\"preview state tag\">\n                            preview / dark\n                        </span>\n                    </div>\n                    <div class=\"rounded-[9px] border border-[var(--atlas-border)] bg-[rgba(11,9,20,.56)] p-4\" data-kid=\"1-2-2-2-2-2\" data-name=\"code token block\">\n                        <div class=\"flex items-center gap-2 text-sm\" data-kid=\"1-2-2-2-2-2-1\" data-name=\"token row\">\n                            <span class=\"text-[var(--atlas-pink)]\" data-kid=\"1-2-2-2-2-2-1-1\" data-name=\"token prefix\">\n                                $\n                            </span>\n                            <code class=\"text-white\" data-kid=\"1-2-2-2-2-2-1-2\" data-name=\"token key\">\n                                --accent:\n                            </code>\n                            <code class=\"text-[var(--atlas-pink)]\" data-kid=\"1-2-2-2-2-2-1-3\" data-name=\"token value\">\n                                #ff007f\n                            </code>\n                        </div>\n                        <div class=\"mt-2 flex items-center gap-2 text-sm\" data-kid=\"1-2-2-2-2-2-2\" data-name=\"token row\">\n                            <span class=\"text-[var(--atlas-cyan)]\" data-kid=\"1-2-2-2-2-2-2-1\" data-name=\"token prefix\">\n                                $\n                            </span>\n                            <code class=\"text-white\" data-kid=\"1-2-2-2-2-2-2-2\" data-name=\"token key\">\n                                --focus:\n                            </code>\n                            <code class=\"text-[var(--atlas-cyan)]\" data-kid=\"1-2-2-2-2-2-2-3\" data-name=\"token value\">\n                                #00f0ff\n                            </code>\n                        </div>\n                    </div>\n                    <div aria-label=\"Preview color swatches\" class=\"mt-5 grid grid-cols-4 gap-2\" data-kid=\"1-2-2-2-2-3\" data-name=\"color swatches grid\">\n                        <div data-kid=\"1-2-2-2-2-3-1\" data-name=\"color swatch item\">\n                            <div class=\"h-12 rounded-[9px] border border-white/10\" data-kid=\"1-2-2-2-2-3-1-1\" data-name=\"color swatch\" style=\"background:#0b0914;\">\n                            </div>\n                            <p class=\"atlas-code mt-2\" data-kid=\"1-2-2-2-2-3-1-2\" data-name=\"color swatch label\">\n                                canvas\n                            </p>\n                        </div>\n                        <div data-kid=\"1-2-2-2-2-3-2\" data-name=\"color swatch item\">\n                            <div class=\"h-12 rounded-[9px] border border-white/10\" data-kid=\"1-2-2-2-2-3-2-1\" data-name=\"color swatch\" style=\"background:#151126;\">\n                            </div>\n                            <p class=\"atlas-code mt-2\" data-kid=\"1-2-2-2-2-3-2-2\" data-name=\"color swatch label\">\n                                surface\n                            </p>\n                        </div>\n                        <div data-kid=\"1-2-2-2-2-3-3\" data-name=\"color swatch item\">\n                            <div class=\"h-12 rounded-[9px] border border-white/10\" data-kid=\"1-2-2-2-2-3-3-1\" data-name=\"color swatch\" style=\"background:#ff007f;\">\n                            </div>\n                            <p class=\"atlas-code mt-2\" data